<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>

    <meta name="description" content="<%= description %>">
    <meta name="keywords" content="<%= keywords %>">
    <link rel="icon" href="http://samgarg.me/favicon.ico" type="image/ico">

    <link href="https://fonts.googleapis.com/css?family=Lato:400,700" rel="stylesheet">
    <link rel="stylesheet" href="https://use.typekit.net/htm6ynp.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Lato', 'Georgia', 'Times New Roman', 'Times', 'serif'],
                    },
                    maxWidth: {
                        resume: '900px',
                    },
                    boxShadow: {
                        resume: '1px 1px 10px 6px #ddd',
                    },
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        /* Din-condensed is a Typekit font — needs a single custom class */
        .font-din {
            font-family: din-condensed, sans-serif;
            font-weight: 400;
            font-style: normal;
        }

        /* Contact links: dotted underline that turns solid on hover */
        .contact-link {
            color: #999;
            text-decoration: none;
            border-bottom: 1px dotted #999;
        }
        .contact-link:hover {
            border-bottom-style: solid;
            color: #000;
        }

        .skill-tag {
            @apply font-din uppercase bg-gray-200 text-gray-600 px-3 py-0.5 rounded text-base;
        }

        .summary h3 {
            @apply font-bold mb-2;
        }

        .summary p {
            @apply mb-6;
        }

        .summary.compact p {
            @apply mb-3;
        }

        @media print {
            body {
                background: white !important;
            }
            #resume {
                box-shadow: none;
                margin: 0;
                width: 1024px;
                padding: 0;
                font-size: 16px;
            }
            .no-print { display: none !important; }
            .skill-tag {
                background: transparent;
                border: 1px solid;
                color: #000;
            }
        }
    </style>
</head>
<body class="bg-gray-100 font-sans text-base">

<nav class="no-print my-5 text-center">
    <a href="<%= pdfLink %>" class="text-gray-500 hover:text-gray-900 transition-colors underline">Download PDF</a>
</nav>

<article id="resume" class="max-w-resume mx-auto px-5 py-5 sm:px-16 sm:py-16 shadow-resume bg-white relative">

    <header class="flex justify-between items-center border-b border-gray-400">
        <h1 class="font-bold mr-4 mb-4 leading-tight">
            <span class="block text-4xl sm:text-5xl">Sam Garg</span>
            <span class="block text-sm font-normal text-gray-500 mt-1"><%- headline %></span>
        </h1>

        <address class="not-italic text-right text-sm sm:text-base shrink-0">
            <div class="mb-1">
                <a href="<%= linkedin.url %>" rel="nofollow" target="_blank" class="contact-link"><%= linkedin.text %></a>
            </div>
            <div>
                <a href="mailto:<%= email %>" target="_blank" class="contact-link"><%= email %></a>
            </div>
        </address>
    </header>

    <section class="summary<%= compact ? ' compact mt-6' : ' pt-9' %> text-justify text-gray-900 text-base mb-12">
<% for (const s of summary) { %>
<% if (s.h) { %>        <h3 class="font-bold"><%- s.h %></h3>
<% } else { %>        <p><%- s.p %></p>
<% } %>
<% } %>
    </section>

    <section class="w-full mb-12">
        <h2 class="font-din uppercase text-3xl mt-5 mb-4">Technical Expertise</h2>
        <div class="flex flex-wrap gap-2">
<% for (const s of skills) { %>
            <span class="skill-tag"><%- s %></span>
<% } %>
        </div>
    </section>

    <section class="w-full mb-12">
        <h2 class="font-din uppercase text-3xl mt-5 mb-4">Work Experience</h2>
<% for (const x of experience) { %>
        <div class="mb-5 leading-normal">
            <header class="font-din uppercase">
                <div class="text-xl font-bold">
<% if (x.url) { %>                    <a href="<%= x.url %>" target="_blank" class="text-black no-underline hover:opacity-70 transition-opacity"><%= x.company %></a>
<% } else { %>                    <%= x.company %>
<% } %>
                </div>
                <div class="text-lg text-gray-400 font-normal"><%- x.role %></div>
            </header>
            <div class="pt-1.5 text-sm">
<% if (x.intro) { %>                <p class="mb-4"><%- x.intro %></p>
<% } %>
<% if (x.bullets) { %>                <ul class="pl-4 list-disc space-y-1">
<% for (const b of x.bullets) { %>                    <li><%- b %></li>
<% } %>                </ul>
<% } %>
<% if (x.text) { %>                <%- x.text %>
<% } %>
            </div>
        </div>
<% } %>
    </section>

    <section class="w-full">
        <h2 class="font-din uppercase text-3xl mt-5 mb-4">Education &amp; Certifications</h2>
<% for (const e of education) { %>
        <div class="mb-5 leading-normal font-din uppercase">
            <div class="text-xl font-bold"><%- e.title %></div>
            <div class="text-lg text-gray-400 font-normal"><%- e.org %></div>
        </div>
<% } %>
    </section>
</article>

<script>
    (function (i, s, o, g, r, a, m) {
        i['GoogleAnalyticsObject'] = r;
        i[r] = i[r] || function () {
            (i[r].q = i[r].q || []).push(arguments)
        }, i[r].l = 1 * new Date();
        a = s.createElement(o),
            m = s.getElementsByTagName(o)[0];
        a.async = 1;
        a.src = g;
        m.parentNode.insertBefore(a, m)
    })(window, document, 'script', '//www.google-analytics.com/analytics.js', 'ga');

    ga('create', 'UA-51438230-1', 'samgarg.me');
    ga('send', 'pageview');
</script>

</body>
</html>
